# ==========================================
# PolicySpace Root Git Ignore
# ==========================================

# ------------------------------------------
# .NET / C# Build Artifacts
# ------------------------------------------
**/[Bb]in/
**/[Oo]bj/
**/[Ll]og/
**/[Ll]ogs/
**/build/
**/out/

# Visual Studio & IDEs
.vs/
.idea/
*.user
*.userosscache
*.sln.docstates
*.suo
*.DotSettings.user

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.assets.json

# Local environments & secrets
appsettings*.local.json
secrets.json
.env
.env*.local
*.env

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Test Results & Code Coverage
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml
*.trx

# Crash Dumps
*.dmp
*.dump
*.mdmp
crashdump.json

# ------------------------------------------
# Node.js / React / Vite (Client & Server-Node)
# ------------------------------------------
**/node_modules/
**/dist/
**/dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# ------------------------------------------
# OS & Miscellaneous
# ------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.sw?
